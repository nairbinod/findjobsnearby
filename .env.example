NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
 
# Used by job seeding scripts AND server-side notification lookups
# (lib/supabase/admin.ts). Never expose or commit this key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI-assisted listing/profile drafting (server-side only). Never expose or commit this key.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Notification emails (US-22/23/24) + future newsletter (§4.18). Server-side only.
RESEND_API_KEY=your-resend-api-key
# Optional: defaults to onboarding@resend.dev until a custom domain is verified in Resend.
RESEND_FROM_EMAIL="FindJobsNearBy <notifications@findjobsnearby.com>"

# Protects the /api/cron/season-return route. Set the same value here and in
# Vercel's env vars -- Vercel Cron attaches it automatically as a bearer token.
CRON_SECRET=a-long-random-string
